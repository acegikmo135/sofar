{
  "name": "sofar-json",
  "version": "0.1.1",
  "description": "Parse JSON while an LLM is still streaming it. Repairs incomplete JSON into the best value so far. Zero dependencies, 425 bytes.",
  "keywords": [
    "json",
    "partial",
    "incomplete",
    "stream",
    "streaming",
    "llm",
    "openai",
    "anthropic",
    "vercel-ai",
    "structured-output",
    "tool-calls",
    "json-repair",
    "partial-json",
    "parse",
    "typescript"
  ],
  "author": "Manthan Kansagra",
  "license": "MIT",
  "homepage": "https://acegikmo135.github.io/sofar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acegikmo135/sofar.git"
  },
  "bugs": {
    "url": "https://github.com/acegikmo135/sofar/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "treeshake": "node scripts/check-treeshake.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run size && npm run treeshake",
    "build:site": "node scripts/build-site.mjs",
    "demo:gif": "npm run build:site && node scripts/capture-demo.mjs",
    "demo:cover": "node scripts/build-cover.mjs"
  },
  "size-limit": [
    {
      "name": "esm (full)",
      "path": "dist/index.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "esm (parsePartialJSON only)",
      "path": "dist/index.js",
      "import": "{ parsePartialJSON }",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "cjs (full)",
      "path": "dist/index.cjs",
      "limit": "2 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "esbuild": "^0.24.2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.11.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
